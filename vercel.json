{
  "rewrites": [
    { "source": "/api/deploy", "destination": "/api/deploy.js" },
    { "source": "/api/sites", "destination": "/api/sites.js" },
    { "source": "/api/ai-edit", "destination": "/api/ai-edit.js" },
    { "source": "/api/media", "destination": "/api/media.js" },
    { "source": "/site/:id", "destination": "/api/site/[id].js" },
    { "source": "/((?!api|site|_next).*)", "destination": "/index.html" }
  ]
}
