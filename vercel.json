{
  "rewrites": [
    { "source": "/api/deploy", "destination": "/api/deploy.js" },
    { "source": "/api/sites", "destination": "/api/sites.js" },
    { "source": "/api/ai-edit", "destination": "/api/ai-edit.js" },
    { "source": "/api/media", "destination": "/api/media.js" },
    { "source": "/api/admin", "destination": "/api/admin.js" },
    { "source": "/api/clone", "destination": "/api/clone.js" },
    { "source": "/api/signin", "destination": "/api/signin.js" },
    { "source": "/api/save-user", "destination": "/api/save-user.js" },
    { "source": "/site/:id", "destination": "/api/site/[id].js" },
    { "source": "/__/auth/:catch*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/changelog", "destination": "/changelog/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/pricing", "destination": "/pricing/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/((?!api|site|_next|sw.js|manifest.json|icon|favicon|apple|robots|docs|changelog|blog|pricing|privacy|terms|__).*)", "destination": "/index.html" }
  ]
}
